{
  "name": "pg-management-system",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:firebase": "vite --mode firebase",
    "firebase:login": "firebase login",
    "firebase:projects": "firebase projects:list",
    "check:rules": "firebase deploy --project lucky-luxury-mens-pg --only firestore:rules --dry-run",
    "deploy:rules": "firebase deploy --project lucky-luxury-mens-pg --only firestore:rules",
    "check:hosting": "firebase deploy --project lucky-luxury-mens-pg --only hosting --dry-run",
    "deploy:hosting": "npm run build:firebase && firebase deploy --project lucky-luxury-mens-pg --only hosting",
    "build": "tsc -b && tsc -p tsconfig.functions.json && npm run check:functions-runtime && vite build",
    "build:firebase": "tsc -b && tsc -p tsconfig.functions.json && npm run check:functions-runtime && vite build --mode firebase",
    "check:functions-runtime": "node --no-experimental-require-module scripts/check-functions-runtime.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:rules": "node scripts/test-access-rules.mjs",
    "test:auth": "node scripts/test-tenant-auth.mjs --start",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b && tsc -p tsconfig.functions.json"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@hookform/resolvers": "^5.9.2",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "firebase": "^13.1.0",
    "firebase-admin": "13.10.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.61.0",
    "motion": "^14.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.6",
    "firebase-tools": "^15.34.1",
    "globals": "^17.13.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.12"
  }
}
