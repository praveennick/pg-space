rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /accounts/{uid}/control/version {
      allow read: if owner(uid);
      allow create: if owner(uid)
        && request.resource.data.keys().hasOnly(['number'])
        && request.resource.data.number == 1;
      allow update: if owner(uid)
        && request.resource.data.keys().hasOnly(['number'])
        && request.resource.data.number == resource.data.number + 1;
    }

    match /accounts/{uid}/records/{entity}/items/{recordId} {
      function knownEntity() {
        return entity in [
          'rooms', 'beds', 'tenants', 'occupancies', 'reservations',
          'invoices', 'payments', 'allocations', 'deposits', 'expenses',
          'tickets', 'notifications', 'audit', 'settings', 'quotations'
        ];
      }
      allow read: if owner(uid) && knownEntity();
      allow create, update: if owner(uid)
        && knownEntity()
        && request.resource.data.id == recordId;
      allow delete: if owner(uid)
        && knownEntity();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
